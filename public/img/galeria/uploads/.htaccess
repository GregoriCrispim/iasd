# Pasta de fotos enviadas pelo painel. Serve apenas arquivos estáticos:
# nada aqui deve ser interpretado como código, mesmo que um upload burle a validação.

Options -Indexes

RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .php8

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
